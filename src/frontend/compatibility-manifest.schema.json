{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localbox.dev/schemas/frontend-compatibility-manifest-v1.json",
  "title": "Localbox frontend compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "frontend",
    "displayName",
    "contract",
    "upstream",
    "notes",
    "publicSurfaces",
    "entries",
    "declarationChecks"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "frontend": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "contract": { "type": "string", "minLength": 1 },
    "upstream": { "$ref": "#/$defs/upstream" },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "publicSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]*$" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "declarationChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/declarationCheck" }
    }
  },
  "$defs": {
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "documentation", "assessed", "scope"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "documentation": { "type": "string", "format": "uri" },
        "assessed": { "type": "string", "format": "date" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "support": {
      "enum": ["native", "emulated", "partial", "not-applicable", "unsupported"]
    },
    "compatibility": {
      "enum": ["compatible", "partial", "incompatible"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "name", "support", "types", "behavior"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "support": { "$ref": "#/$defs/support" },
        "types": { "$ref": "#/$defs/compatibility" },
        "behavior": { "$ref": "#/$defs/compatibility" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "support": { "not": { "const": "native" } } },
            "required": ["support"]
          },
          "then": { "required": ["rationale"] }
        }
      ]
    },
    "declarationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "extractor",
        "path",
        "declaration",
        "staticPrefix",
        "instancePrefix"
      ],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "extractor": { "const": "typescript-class-methods" },
        "path": { "type": "string", "pattern": "^\\./" },
        "declaration": { "type": "string", "minLength": 1 },
        "staticPrefix": { "type": "string", "minLength": 1 },
        "instancePrefix": { "type": "string", "minLength": 1 }
      }
    }
  }
}
